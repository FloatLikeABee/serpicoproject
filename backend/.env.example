PORT=5092

# LLM providers — interactive chat always uses SiliconFlow DeepSeek-V4-Flash
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Aliases still honored: QWEN_API_KEY / QWEN_MODEL / QWEN_BASE_URL
QWEN_API_KEY=
DASHSCOPE_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# RAG & features
RAG_DATA_PATH=./data/rag
ENABLE_WEB_SEARCH=true

# Chase Game
CHASE_GAME_MAX_ROUNDS=4

# Image generation for Chase Game scenarios
# Supported providers: openai | stability | replicate | placeholder
IMAGE_PROVIDER=placeholder
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=stable-diffusion-xl-1024-v1-0
STABILITY_API_HOST=https://api.stability.ai
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
